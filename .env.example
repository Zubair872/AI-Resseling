NODE_ENV=development
API_PORT=4000
JWT_EXPIRES_IN=15m
CORS_ORIGIN=http://localhost:5173
# AI Provider: 'template' (local rule-based, no external key needed) or 'openai' (calls OpenAI or Google Gemini)
AI_PROVIDER=openai
AI_API_KEY=your-api-key-here
# Google Gemini (OpenAI-compatible endpoint, no trailing slash):
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
AI_MODEL=gemini-2.5-flash
# Standard OpenAI alternative:
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o-mini

# Optional production overrides:
# DATABASE_URL=postgres://user:password@host:5432/orbitly
# REDIS_URL=redis://host:6379
# JWT_SECRET=replace-with-a-long-random-secret
# INTEGRATION_ENCRYPTION_KEY=64-hex-characters-from-openssl-rand-hex-32
# Customer chat (Meta). See DEPLOYMENT.md, "Meta customer chat".
# META_APP_SECRET=from-your-meta-app-settings
# META_VERIFY_TOKEN=any-long-random-string-you-choose
# META_GRAPH_VERSION=v23.0

# Email (Resend). Without it no email is delivered (verification/reset/invite links appear in the server log in development only).
# MAIL_PROVIDER=resend
# RESEND_API_KEY=re_xxx
# MAIL_FROM=Orbitly <no-reply@your-verified-domain.com>
# Card payments for subscriptions (Stripe)
# STRIPE_SECRET_KEY=sk_live_xxx
# STRIPE_WEBHOOK_SECRET=whsec_xxx
# Object storage for uploads (any S3-compatible bucket: AWS S3, Cloudflare R2, Backblaze B2, MinIO)
# STORAGE_PROVIDER=s3
# S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_BUCKET=orbitly
# S3_ACCESS_KEY_ID=xxx
# S3_SECRET_ACCESS_KEY=xxx
# S3_PUBLIC_BASE_URL=https://cdn.your-domain.com   # public URL of the bucket, needed for product images
# Google Sheets sync (service account JSON on ONE line)
# GOOGLE_SERVICE_ACCOUNT_JSON={"client_email":"...","private_key":"..."}
# Payment screenshot OCR hint (uses AI_API_KEY and AI_BASE_URL)
# OCR_PROVIDER=openai_vision
# OCR_MODEL=gpt-4o-mini

# ---- Round 12: login-based connect (OAuth), LLM assistant prices ----
# PUBLIC_API_URL must be the PUBLIC https address of this API (OAuth redirect URLs are built from it)
# PUBLIC_API_URL=https://api.your-domain.com
# META_APP_ID=123456789012345          # numeric App ID of your Meta app (META_APP_SECRET is above)
# META_OAUTH_SCOPES=                   # optional override, comma separated
# TIKTOK_CLIENT_KEY=xxx
# TIKTOK_CLIENT_SECRET=xxx
# TIKTOK_OAUTH_SCOPES=user.info.basic,video.publish
# Optional: lets the AI assistant estimate cost (USD per 1M tokens). Look up your model's current prices; they are NOT hard-coded.
# AI_PRICE_INPUT_PER_1M=0.15
# AI_PRICE_OUTPUT_PER_1M=0.60

# ---- Round 15: FREE AI for post wording (optional; the default `template` needs nothing) ----
# Google Gemini (free key from https://aistudio.google.com/apikey). Check ai.google.dev for the current free model name.
# AI_PROVIDER=openai
# AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# AI_MODEL=gemini-2.0-flash
# AI_API_KEY=your-gemini-key
# Or Groq (free key from https://console.groq.com): AI_BASE_URL=https://api.groq.com/openai/v1 and a current Groq model name.
# Posting channels (Bluesky, Mastodon, Discord) need NO .env settings: connect them in the app, Markaz Studio, Step 1.
